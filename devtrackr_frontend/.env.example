# Frontend runtime configuration
# Set this to your FastAPI backend base URL (no trailing slash), e.g.
# NEXT_PUBLIC_API_BASE_URL=https://vscode-internal-xxxxx-uat.uat01.cloud.kavia.ai:3001
#
# Note: The backend must set CORS_ALLOW_ORIGINS to this frontend origin and allow_credentials=true
# so session cookies (HttpOnly JWT cookies) are sent with requests.
NEXT_PUBLIC_API_BASE_URL=
